# ────────────────────────────────────────────────────────
# 큐기출 docker-compose 용 환경변수 모음
# 실제 값은 .env 에 채워 넣고, 절대 git 커밋하지 말 것.
# ────────────────────────────────────────────────────────

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# MySQL (로컬 Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=qgichul

# Backend → DB (docker-compose 내부 통신: db:3306)
DB_URL=jdbc:mysql://db:3306/qgichul?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=qgichul
DB_PASSWORD=qgichul_pass

# Backend → JWT (openssl rand -base64 64 결과)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Backend → CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI server → OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Frontend → 백엔드 base URL
VITE_API_BASE_URL=http://localhost:8080
